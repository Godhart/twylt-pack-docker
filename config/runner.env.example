TWYLT_GUARDRAILS=1
TWYLT_DISABLE_NETWORK=0
# Optional separate transport root, including descendants:
# TWYLT_ALLOWED_CWD=/tmp/toolhub-runs
# Trusted runner settings. Create workspace and logs directories first.
TWYLT_WORKSPACE_ROOT=/srv/agent/workspace
TWYLT_INCIDENT_LOG=/srv/agent/logs/docker-incidents.jsonl
TWYLT_DOCKER_ALLOW_PULL=false
TWYLT_DOCKER_REGISTRY=docker.io
TWYLT_DOCKER_CPUS=1
TWYLT_DOCKER_MEMORY=512m
TWYLT_DOCKER_MAX_CONTAINERS=2
TWYLT_DOCKER_MAX_TIMEOUT=300
# Local Linux Engine only; rootless socket can also be specified here.
DOCKER_HOST=unix:///var/run/docker.sock

# Reject application network access, even when network=enabled is requested.
TWYLT_DOCKER_DISABLE_NETWORK=false

# Engine: docker (default) or podman. Existing TWYLT_DOCKER_* policies apply to both.
TWYLT_CONTAINER_ENGINE=docker
# Optional explicit local Unix socket (takes precedence over engine defaults):
# TWYLT_CONTAINER_HOST=unix:///run/user/1000/podman/podman.sock
